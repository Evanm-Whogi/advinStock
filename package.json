{
	"name": "advinstock",
	"version": "1.0.0",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc --noEmit false",
		"start": "node dist/index.js",
		"dev": "tsx watch src/index.ts",
		"typecheck": "tsc --noEmit",
		"test": "npm run build && node --test tests/*.test.cjs",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test"
	},
	"author": "",
	"license": "ISC",
	"description": "Discord stock alerts and inventory summaries for Advin Servers.",
	"dependencies": {
		"@sapphire/framework": "^5.5.1",
		"axios": "^1.20.0",
		"discord.js": "^14.27.0",
		"dotenv": "^18.0.9"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^24.0.0",
		"eslint": "^10.14.0",
		"prettier": "^3.9.10",
		"tsx": "^4.23.15",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.2"
	},
	"private": true,
	"engines": {
		"node": "^24.22.1"
	},
	"overrides": {
		"minimatch": "^11.0.1"
	}
}
